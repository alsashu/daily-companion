# Copy to .env and replace the placeholder password:  cp .env.example .env
# Never commit .env. These values are placeholders, not real secrets.

# Runtime mode for the backend container.
NODE_ENV=production

# Port the backend listens on inside its container. Keep in sync with nginx.conf.
PORT=5000

# PostgreSQL credentials, used by the postgres container on first initialization.
POSTGRES_DB=daily_companion
POSTGRES_USER=daily_companion_user
POSTGRES_PASSWORD=replace_with_a_secure_password

# Backend connection string. Host must be "postgres" (the Compose service name).
# User, password and database must match the three values above.
# If the password contains special characters (@ : / ? #), URL-encode them here.
DATABASE_URL=postgresql://daily_companion_user:replace_with_a_secure_password@postgres:5432/daily_companion

# Host ports for local access.
FRONTEND_PORT=3000
BACKEND_PORT=5000
# Only used by docker-compose.dev.yml (PostgreSQL on 127.0.0.1 for local development).
POSTGRES_PORT=5432

# Tag applied to built images (e.g. 1.0.0 for a release).
IMAGE_TAG=local
